{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kdcn-platform-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
  "directory": "../dashboard",
  "binding": "ASSETS",
  "run_worker_first": true,
  "html_handling": "none"
},
  "vars": {
    "ENVIRONMENT": "production",
    "JWT_ISSUER": "admin.kingmandigital.co.ke",
    "JWT_AUDIENCE": "kdcn-platform-api",
    "ACCESS_TOKEN_TTL_SECONDS": "900",
    "REFRESH_TOKEN_TTL_DAYS": "7"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kdcn-platform",
      "database_id": "089c592f-5089-43b1-bc2b-126c2d604500"
    }
  ],
  "routes": [
    {
      "pattern": "admin.kingmandigital.co.ke",
      "custom_domain": true
    }
  ]
}
